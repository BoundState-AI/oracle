# ORACLE — Environment configuration template
#
# Copy to `.env` (gitignored) for local runs, or set these as variables in your
# deployment platform (e.g. Railway → service → Variables). Never commit real
# secrets — `.env` and `*.key` are gitignored on purpose.
#
# Only the API keys for the providers/oracles you actually use are required.
# Everything under "Optional overrides" has a sensible default baked into the
# code; set them only to deviate.

# ── Provider API keys ───────────────────────────────────────────────────────
# Anthropic — Beth oracle + Sonnet enrichment + generic extraction.
ANTHROPIC_API_KEY=sk-ant-api03-...
# OpenAI — Fran + Codex oracles.
OPENAI_API_KEY=sk-...
# xAI — Grok oracle.
XAI_API_KEY=xai-...
# Google — Gemini oracle (either name is accepted).
GOOGLE_API_KEY=...
GEMINI_API_KEY=...

# ── Server / deployment ─────────────────────────────────────────────────────
# Shared secret guarding the /oracle API routes (server.py). Leave unset to
# disable auth (local dev only); set a strong value in any deployed env.
ORACLE_API_KEY=
# CORS origin for the frontend.
FRONTEND_URL=http://localhost:3000
# Use AWS Bedrock instead of the Anthropic API for Claude calls (1/true/yes).
USE_BEDROCK=1

# ── Runtime paths ───────────────────────────────────────────────────────────
ORACLE_PACK_DIR=
ORACLE_SESSIONS_DIR=oracle_sessions

# ── Optional model overrides (defaults shown) ───────────────────────────────
# ORACLE_BETH_MODEL=claude-opus-4-8
# ORACLE_SONNET_MODEL=claude-sonnet-4-6
# ORACLE_FRAN_MODEL=gpt-5.4
# ORACLE_CODEX_MODEL=gpt-5.4
# ORACLE_GROK_MODEL=grok-4.20
# ORACLE_GEMINI_MODEL=gemini-2.5-pro

# ── Optional workflow / behavior overrides ──────────────────────────────────
# ORACLE_WORKFLOW=manual                 # manual | ledger
# ORACLE_CHAT_PROVIDER=                   # force a chat provider; auto-detected otherwise
# ORACLE_DISABLE_BOOTSTRAP_PACKS=
# ORACLE_MAX_CONTEXT_TOKENS=
# ORACLE_TIMEOUT_SECONDS=
# ORACLE_MAX_CONSECUTIVE_INVALID_ROUNDS=

# ── sentinel/tocr ───────────────────────────────────────────────────────────
# TOCR_CORS_ORIGINS=
# TOCR_SONNET_MAX_TOKENS=
